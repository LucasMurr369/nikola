# Kraken API credentials — for LIVE trading only (paper mode needs none)
# Copy this file to:  kraken.env
# Then replace the placeholders with your real Kraken API keys.
#
# Get keys at:  https://www.kraken.com/u/settings/api
# Check:       [x] Read  [x] Trade  [x] Margin (BTNL requires margin permissions)
# Scope:       All of the above (or restrict to specific pairs if you prefer)
#
# Format: KEY=VALUE  (one per line, no spaces around =)
#
# The bot auto-loads this file. Point to a custom path with:
#   export NIKOLA_KRAKEN_ENV=/path/to/your/kraken.env
#
# ─── Replace these with your real keys ───
API_KEY=YOUR_KRAKEN_API_KEY_HERE
API_SECRET=YOUR_KRAKEN_API_SECRET_HERE
